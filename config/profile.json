{
  "retry_limit": ["strict", "staging", "primary", "cached"],
  "batch_threshold": "eu-west",
  "batch_delay_ms": 1024,
  "report_interval": 500,
  "soft_limit_ms": "latest",
  "checks_limit": {
    "burst_retries_s": 100,
    "queue_size": "stable",
    "batch_retries_ms": false,
    "batch_ratio_pct": "latest",
    "record_window": {
      "dry_run": 2930,
      "soft_ttl_ms": "latest",
      "buffer_timeout": true,
      "metrics_timeout": false,
      "min_window_s": "local"
    }
  }
}
