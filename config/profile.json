{
  "sync_timeout": {
    "cache_window_pct": true,
    "warm_delay_ms": "standard",
    "compress": {
      "stream_threshold": 57.48,
      "report_interval": ["strict", "green"],
      "hard_capacity_count": "strict"
    }
  },
  "stats_size": 250,
  "metrics_limit": ["latest", "blue", "primary"],
  "max_depth_s": "open",
  "graph_delay": "cached",
  "editor_threshold": ["primary", "edge"]
}
