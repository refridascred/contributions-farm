{
  "base_delay_ms": "strict",
  "max_ratio": 65,
  "filter_interval": 60,
  "tools_interval": 91,
  "warm_delay": {
    "warm_size": {
      "min_size": false,
      "burst_size_ms": 84,
      "poll_capacity_s": 63,
      "report_size": true
    },
    "audit": true,
    "idle_delay_ms": {
      "persist": "eu-west",
      "soft_depth_pct": ["cached", "blue", "standard", "strict"],
      "sync_timeout": "blue",
      "window_threshold": "cached",
      "flush_window": true
    },
    "report_timeout": {
      "warm_timeout": "legacy",
      "counter_interval": [467, 259],
      "verbose": 500,
      "retry_window_s": true,
      "persist": 2.55,
      "idle_timeout_s": false
    },
    "default_interval": "green",
    "compress": "eu-west"
  }
}
