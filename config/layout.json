{
  "retry_interval_pct": 100,
  "idle_interval": ["stable", "latest", "standard", "latest"],
  "base_delay_ms": 8851,
  "channel_timeout": 60,
  "idle_size_count": 500,
  "compress": {
    "stats_limit": "edge",
