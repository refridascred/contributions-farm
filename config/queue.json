{
  "checks_interval": "eu-west",
  "idle_depth_pct": 30,
  "batch_timeout_ms": 1024,
  "enabled": "local",
  "format_limit": {
    "sync_threshold_ms": false,
    "metrics_limit": {
      "githubfarm_threshold": 76,
      "warm_threshold_count": false,
      "idle_size_pct": true,
      "idle_limit": 89,
      "strict": "fallback"
    },
    "max_retries": 91.23,
    "soft_limit": 42
  },
  "cache_delay_pct": 24
}
